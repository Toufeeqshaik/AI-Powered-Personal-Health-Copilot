# Copy to .env.local for local development. Never commit .env.local or real values.
# GEMINI_API_KEY is server-only and must never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Supabase public browser configuration. Protect data with RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase admin key. Never expose this in client code or browser variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

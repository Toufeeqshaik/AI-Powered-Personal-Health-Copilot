# Copy to .env.local for local development. Never commit .env.local or real values.
# GEMINI_API_KEY is server-only and must never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional server-side chat fallback (BazaarLink OpenAI-compatible gateway).
BAZAARLINK_API_KEY=your-bazaarlink-api-key
BAZAARLINK_MODEL=qwen/qwen3.7-flash:free

# Optional second server-side chat fallback (Groq OpenAI-compatible API).
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Supabase public browser configuration. Protect data with RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase admin key. Never expose this in client code or browser variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
